{
  "name": "SelahNative",
  "id": "SelahNative",
  "version": "1.0.0",
  "description": "Selah 3.0 widget payload cache + alternate icon bridge",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "ios": {
      "plugins": [
        {
          "type": "module",
          "name": "SelahNative",
          "class": "SelahNativeModule"
        }
      ],
      "integrateType": "source",
      "deploymentTarget": "13.0",
      "frameworks": [
        "UIKit.framework",
        "Foundation.framework",
        "WidgetKit.framework"
      ]
    },
    "android": {
      "plugins": [
        {
          "type": "module",
          "name": "SelahNative",
          "class": "com.selah.nativeplugin.SelahNativeModule"
        }
      ],
      "integrateType": "aar",
      "minSdkVersion": "21",
      "permissions": [],
      "abis": ["armeabi-v7a", "arm64-v8a"]
    }
  }
}
